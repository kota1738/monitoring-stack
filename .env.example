# Copy to .env and set real values. .env is gitignored.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-now

# Shared secret for anything that posts to the alert sink directly.
ALERT_SINK_TOKEN=change-me

# Discord delivery. The sink forwards every Alertmanager notification to this
# webhook, so the URL stays here rather than in a tracked config file.
#
# Create one in Discord: Server Settings -> Integrations -> Webhooks ->
# New Webhook -> choose a channel -> Copy Webhook URL. Treat the URL as a
# password: anyone holding it can post to that channel.
#
# Leave DISCORD_WEBHOOK_URL empty to record alerts without notifying anyone.
DISCORD_WEBHOOK_URL=
# Optional: a role or user to ping on firing alerts, e.g. "<@&1234567890>".
DISCORD_MENTION=
DISCORD_USERNAME=server-monitoring
